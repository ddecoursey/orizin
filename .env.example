FMP_API_KEY=your_fmp_api_key_here
# Railway: attach a persistent volume at /data. DB_PATH may be omitted there;
# the server will use RAILWAY_VOLUME_MOUNT_PATH/screener.db automatically.
DB_PATH=/data/screener.db
PORT=3001

# ── Gemini (Ori AI) ──────────────────────────────────────────────────────────
# Primary key — used for chat, the Deep Research Game Plan, everything.
GEMINI_API_KEY=your_gemini_api_key_here
# OPTIONAL backup key. The model ladder is tried on the primary key first, then
# again on this backup key. Only adds real headroom if it's in a DIFFERENT Google
# Cloud project — Gemini quota is per-project, not per-key.
GEMINI_API_KEY_BACKUP=
# Model tiers. On a "too busy"/unavailable response the request fails over
# frontier → value → lite (and then the same ladder on the backup key).
#   frontier: Deep Research Game Plan ONLY, ~once per stock / week (scarce; tried
#             only on the primary key so its quota is never spent twice).
#   value:    chat + everything else (the workhorse).
#   lite:     screener intangibles trickle + structured fallback (cheap).
GEMINI_FRONTIER_MODEL=gemini-3.1-pro-preview
GEMINI_VALUE_MODEL=gemini-3.5-flash
GEMINI_LITE_MODEL=gemini-3.1-flash-lite
# Thinking/reasoning level per journey. On 3.x Pro/Flash thinking DEFAULTS to
# "high" and those thinking tokens bill at the full output rate, so we dial each
# path down. Valid: minimal | low | medium | high (Pro can't go below low; set
# "default" to leave a model at its built-in level). 2.5 models map to a budget.
ORI_CHAT_THINKING_LEVEL=minimal
GAME_PLAN_THINKING_LEVEL=medium
GEMINI_LITE_THINKING_LEVEL=minimal
# Game Plan output-token cap. Thinking tokens bill AGAINST this budget, so it must
# fit both the model's thinking AND the rich JSON or the response truncates and
# fails. Default 4000 — raise if you see empty/MAX_TOKENS Game Plan failures.
GAME_PLAN_MAX_OUTPUT=4000
# Deep Research Pro cache (SQLite kv_cache `gameplan:`) — default 7 days.
GAME_PLAN_FRONTIER_TTL_DAYS=7
# Screener lite intangibles cache (`gameplan-lite:`) — default 24h.
GAME_PLAN_LITE_TTL_HOURS=24
# Ori chat static system prompt cache (Gemini cachedContents). Default 24h.
# GEMINI_CONTEXT_CACHE_TTL_HOURS=24
# GEMINI_CONTEXT_CACHE_ENABLED=true

# ── Ori usage limits (Pro fair-use, Anthropic-style layered caps) ───────────
# One request unit = one paid Gemini generation. Ordinary chat uses one; an
# explicit live-FMP turn uses two (one Lite planner + one cached final answer).
# Session is a rolling window; daily / weekly / monthly are calendar-based (ET).
ORI_SESSION_HOURS=5
ORI_SESSION_LIMIT=18
ORI_DAILY_LIMIT=25
ORI_WEEKLY_LIMIT=70
ORI_MONTHLY_LIMIT=280
# A second, dollar-denominated guard protects margins if model prices or token
# shapes change. Stored Gemini usageMetadata is priced per actual model.
ORI_DAILY_COST_LIMIT_USD=0.75
ORI_WEEKLY_COST_LIMIT_USD=2.50
ORI_MONTHLY_COST_LIMIT_USD=6.00
# Admins have full feature access but share these meters by default. Opting out
# is intentionally explicit because QA/owner testing uses the same paid API.
ORI_ADMIN_UNLIMITED=false
# Starfarer (ultimate) — admin-granted only; defaults ~2× Voyager if unset.
ORI_STARFARER_SESSION_LIMIT=36
ORI_STARFARER_DAILY_LIMIT=50
ORI_STARFARER_WEEKLY_LIMIT=140
ORI_STARFARER_MONTHLY_LIMIT=560
ORI_STARFARER_DAILY_COST_LIMIT_USD=1.50
ORI_STARFARER_WEEKLY_COST_LIMIT_USD=5.00
ORI_STARFARER_MONTHLY_COST_LIMIT_USD=12.00

# ── Session inactivity (all users) ───────────────────────────────────────────
# Users are signed out after this many milliseconds without API activity.
# Client idle timer should match (server reads this for /api/auth/me).
SESSION_INACTIVITY_MS=3600000

# ── Ori chat cost controls ───────────────────────────────────────────────────
# Only the most recent N messages are sent to Gemini; full history stays in DB.
ORI_CHAT_HISTORY_MAX=16
# Deep Research chat — shorter history window (default 10 ≈ 5 turns).
ORI_CHAT_HISTORY_MAX_DR=10
ORI_CHAT_HISTORY_MSG_CHARS=6000
# Per-view max output tokens (caps reply + thinking cost).
ORI_CHAT_MAX_OUTPUT_SCREENER=2000
ORI_CHAT_MAX_OUTPUT_DR=3000
ORI_CHAT_MAX_OUTPUT_PORTFOLIO=2000
ORI_CHAT_FETCH_TIMEOUT_MS=45000
ORI_CHAT_STREAM_TIMEOUT_MS=180000
# Explicit Gemini cachedContents for the shared Ori chat system prompt (all users).
# The current ~4.3k-token cache costs about $0.10/day in fixed storage and
# breaks even around 18 Flash chat turns/day at standard pricing. Set false for
# lower-volume deployments; Gemini may still apply its free implicit cache.
GEMINI_CONTEXT_CACHE_ENABLED=true
GEMINI_CONTEXT_CACHE_TTL_HOURS=24
# Cost-safe defaults: cache only the high-volume value-model screener prompt in
# production. QA/dev create no paid cache resources unless explicitly opted in.
GEMINI_CONTEXT_CACHE_VIEWS=screener
GEMINI_CONTEXT_CACHE_LITE_ENABLED=false
GEMINI_CONTEXT_CACHE_NONPROD_ENABLED=false
# Autonomous Flash-Lite screener scoring is OFF by default. Enable only when you
# deliberately want the production server to generate up to one new score/hour.
SCREENER_INTANGIBLES_ENABLED=false
# SCREENER_INTANGIBLES_TICK_MS=3600000
# SCREENER_INTANGIBLES_BATCH=1
# SCREENER_INTANGIBLES_TTL_DAYS=30
# SCREENER_INTANGIBLES_MIN_MCAP=10000000000

# ── PayPal subscriptions ─────────────────────────────────────────────────────
# 'sandbox' for local testing, 'live' in production (set in Railway, not here).
PAYPAL_ENV=sandbox
# REST app credentials from the PayPal Developer dashboard. The client id is also
# used by the browser SDK (not secret); the secret is server-only — never commit it.
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret
# The subscription plan buyers subscribe to (P-XXXX). Sandbox and live each have
# their OWN plan id — set the one matching PAYPAL_ENV.
PAYPAL_PLAN_ID=your_paypal_plan_id
# Webhook id (Developer > Webhooks). Required in production to verify webhook
# signatures; optional locally (PayPal can't reach localhost).
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
# Per-request PayPal HTTP deadline (OAuth and REST calls), in milliseconds.
PAYPAL_HTTP_TIMEOUT_MS=15000

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Transactional emails: welcome (signup), subscription started/cancelled, and
# password reset. Uses the Resend HTTP API. If RESEND_API_KEY is unset, emails
# are skipped (logged only) and nothing breaks. The FROM address must be on a
# domain you've verified in Resend. Orizin's verified sender domain is
# orizin.app in BOTH QA and production, even though production is served from
# www.orizin.io. Do not change this sender to @orizin.io.
EMAIL_FROM=Orizin <noreply@orizin.app>
RESEND_API_KEY=
# Per-send Resend/SendGrid HTTP deadline, in milliseconds.
EMAIL_HTTP_TIMEOUT_MS=10000
# Optional fallback provider; leave blank when using Resend.
SENDGRID_API_KEY=
# Public app URL — used for email CTAs AND the password-reset link origin
# (must be the real, reachable app URL or reset links won't work).
APP_URL=https://www.orizin.io

# ── Deployment / multi-environment (QA + prod at once) ───────────────────────
# The SAME code runs in every environment; behavior is driven entirely by these
# vars, so a QA Railway service (sandbox creds, QA branch) and a prod service
# (live creds, main branch) coexist with no code differences.
#
# APP_ENV: logical environment label. Anything other than 'production' shows a
# QA badge in the UI so the two are never confused. Set APP_ENV=qa on the QA
# service and APP_ENV=production on prod. (If unset, it's inferred from PAYPAL_ENV.)
APP_ENV=qa
# Keep QA browser signups from sending real welcome/deletion mail.
# Production should omit this or set it to false.
EMAIL_DISABLED=true
# AUTH_SECRET: session-cookie signing key. MUST be set and DIFFERENT per
# environment, so a QA session token can never be replayed on prod. Generate
# with: openssl rand -hex 32. Startup requires at least 32 bytes when deployed.
AUTH_SECRET=set-a-unique-random-value-per-environment
# Required only when a deployed/live database has zero users. The first admin
# must enter this private one-time bootstrap secret; use at least 24 random
# characters (recommended: `openssl rand -hex 32`). It is ignored after the
# first account exists, but should remain server-side and never be shared.
FIRST_ADMIN_SETUP_TOKEN=set-a-long-random-bootstrap-secret
#
# Also give each Railway environment its OWN database volume so QA and prod never
# share data. Startup intentionally fails if Railway SQLite is outside that volume.

# ── FMP plan gates (optional — unset means no restriction) ───────────────────
# Starter plans limit governance-executive-compensation to specific tickers.
# Set a comma-separated allowlist here to skip FMP calls (and 402 log noise) for
# other symbols. Remove or leave blank after upgrading to fetch exec-comp for all.
# FMP_EXEC_COMP_SYMBOLS=AAPL,TSLA,AMZN,MSFT,NVDA,GOOGL,META,NFLX,JPM,V,BAC,PYPL,DIS,T,PFE,COST,INTC,KO,TGT,NKE,SPY,BA,BABA,XOM,WMT,GE,CSCO,VZ,JNJ,CVX,PLTR,SQ,SHOP,SBUX,SOFI,HOOD,RBLX,SNAP,AMD,UBER,FDX,ABBV,ETSY,MRNA,LMT,GM,F,LCID,CCL,DAL,UAL,AAL,TSM,SONY,ET,MRO,COIN,RIVN,RIOT,CPRX,VWO,SPYG,NOK,ROKU,VIAC,ATVI,BIDU,DOCU,ZM,PINS,TLRY,WBA,MGM,NIO,C,GS,WFC,ADBE,PEP,UNH,CARR,HCA,TWTR,BILI,SIRI,FUBO,RKT
# A 402 is also remembered in-process so the same unavailable symbol is not
# retried on every refresh.

# ── FMP MCP tools for Ori ────────────────────────────────────────────────────
# Enabled automatically when FMP_API_KEY is set, but declarations are offered
# only when the user explicitly asks for live/current data. A small Lite planner
# selects one source; the final answer returns to the cached chat path.
FMP_MCP_ENABLED=true
# Usually leave this unset; override only if FMP changes the hosted server URL.
# FMP_MCP_URL=https://financialmodelingprep.com/mcp
ORI_FMP_MCP_MAX_TOOLS=4
ORI_FMP_PLANNING_MAX_OUTPUT=384
FMP_MCP_TIMEOUT_MS=20000
FMP_MCP_MAX_RESULT_CHARS=4000

# ── FMP rate limiting (important when QA + prod SHARE one FMP key) ────────────
# Each process rate-limits itself independently, so two environments on the same
# key can sum past your plan's limit. Cap each env so the TOTAL stays under it —
# e.g. prod FMP_MAX_RPM=250, QA FMP_MAX_RPM=40 (≈290 combined < 300 plan).
FMP_MAX_RPM=250
# Reject excess callers instead of letting the in-process FMP queue grow forever.
FMP_MAX_QUEUE_MS=45000
# Newer FMP company-screener pagination keeps large refresh responses bounded.
FMP_SCREENER_PAGE_SIZE=1000
# The always-on background enrichment job is the biggest continuous consumer.
# Turn it OFF in QA (test on-demand only) so prod gets the quota; keep it on in prod.
ENABLE_BACKGROUND_ENRICH=true
BACKGROUND_ENRICH_RPM=150
# (Cleanest of all: give QA its own separate FMP key/plan if you can.)
