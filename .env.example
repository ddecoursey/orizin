FMP_API_KEY=your_fmp_api_key_here
DB_PATH=/data/screener.db
PORT=3001

# ── Gemini (Ori AI) ──────────────────────────────────────────────────────────
# Primary key — used for chat, the Deep Research Game Plan, everything.
GEMINI_API_KEY=your_gemini_api_key_here
# OPTIONAL backup key. The model ladder is tried on the primary key first, then
# again on this backup key. Only adds real headroom if it's in a DIFFERENT Google
# Cloud project — Gemini quota is per-project, not per-key.
GEMINI_API_KEY_BACKUP=
# Model tiers. On a "too busy"/unavailable response the request fails over
# frontier → value → lite (and then the same ladder on the backup key).
#   frontier: Deep Research Game Plan ONLY, ~once per stock / week (scarce; tried
#             only on the primary key so its quota is never spent twice).
#   value:    chat + everything else (the workhorse).
#   lite:     screener intangibles trickle + structured fallback (cheap).
GEMINI_FRONTIER_MODEL=gemini-3.1-pro-preview
GEMINI_VALUE_MODEL=gemini-3.5-flash
GEMINI_LITE_MODEL=gemini-3.1-flash-lite
# Deep Research Pro cache (SQLite kv_cache `gameplan:`) — default 7 days.
GAME_PLAN_FRONTIER_TTL_DAYS=7
# Screener lite intangibles cache (`gameplan-lite:`) — default 24h.
GAME_PLAN_LITE_TTL_HOURS=24
# Ori chat static system prompt cache (Gemini cachedContents). Default 1h.
# GEMINI_CONTEXT_CACHE_TTL_HOURS=1
# GEMINI_CONTEXT_CACHE_ENABLED=true

# ── Ori usage limits (Pro fair-use, Anthropic-style layered caps) ───────────
# One request = one Ori chat reply or one Deep Research Game Plan (cache miss).
# Session is a rolling window; daily / weekly / monthly are calendar-based (ET).
ORI_SESSION_HOURS=5
ORI_SESSION_LIMIT=18
ORI_DAILY_LIMIT=25
ORI_WEEKLY_LIMIT=70
ORI_MONTHLY_LIMIT=280
# Starfarer (ultimate) — admin-granted only; defaults ~2× Voyager if unset.
ORI_STARFARER_SESSION_LIMIT=36
ORI_STARFARER_DAILY_LIMIT=50
ORI_STARFARER_WEEKLY_LIMIT=140
ORI_STARFARER_MONTHLY_LIMIT=560

# ── Session inactivity (all users) ───────────────────────────────────────────
# Users are signed out after this many milliseconds without API activity.
# Client idle timer should match (server reads this for /api/auth/me).
SESSION_INACTIVITY_MS=3600000

# ── Ori chat cost controls ───────────────────────────────────────────────────
# Only the most recent N messages are sent to Gemini; full history stays in DB.
ORI_CHAT_HISTORY_MAX=24
ORI_CHAT_HISTORY_MSG_CHARS=12000
ORI_CHAT_FETCH_TIMEOUT_MS=45000
ORI_CHAT_STREAM_TIMEOUT_MS=180000
# Explicit Gemini cachedContents for the shared Ori chat system prompt (all users).
# Set GEMINI_CONTEXT_CACHE_ENABLED=false to disable and send the full prompt inline.
GEMINI_CONTEXT_CACHE_ENABLED=true
GEMINI_CONTEXT_CACHE_TTL_HOURS=1

# ── PayPal subscriptions ─────────────────────────────────────────────────────
# 'sandbox' for local testing, 'live' in production (set in Railway, not here).
PAYPAL_ENV=sandbox
# REST app credentials from the PayPal Developer dashboard. The client id is also
# used by the browser SDK (not secret); the secret is server-only — never commit it.
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret
# The subscription plan buyers subscribe to (P-XXXX). Sandbox and live each have
# their OWN plan id — set the one matching PAYPAL_ENV.
PAYPAL_PLAN_ID=your_paypal_plan_id
# Webhook id (Developer > Webhooks). Required in production to verify webhook
# signatures; optional locally (PayPal can't reach localhost).
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Transactional emails: welcome (signup), subscription started/cancelled, and
# password reset. Uses the Resend HTTP API. If RESEND_API_KEY is unset, emails
# are skipped (logged only) and nothing breaks. The FROM address must be on a
# domain you've verified in Resend. EMAIL_FROM + APP_URL are env-driven, so the
# orizin.app -> orizin.io domain switch is just a value change here (no code).
EMAIL_FROM=Orizin <support@orizin.app>
RESEND_API_KEY=
# Optional fallback provider; leave blank when using Resend.
SENDGRID_API_KEY=
# Public app URL — used for email CTAs AND the password-reset link origin
# (must be the real, reachable app URL or reset links won't work).
APP_URL=https://orizin.app

# ── Deployment / multi-environment (QA + prod at once) ───────────────────────
# The SAME code runs in every environment; behavior is driven entirely by these
# vars, so a QA Railway service (sandbox creds, QA branch) and a prod service
# (live creds, main branch) coexist with no code differences.
#
# APP_ENV: logical environment label. Anything other than 'production' shows a
# QA badge in the UI so the two are never confused. Set APP_ENV=qa on the QA
# service and APP_ENV=production on prod. (If unset, it's inferred from PAYPAL_ENV.)
APP_ENV=qa
# AUTH_SECRET: session-cookie signing key. MUST be set and DIFFERENT per
# environment, so a QA session token can never be replayed on prod. Generate
# with: openssl rand -hex 32
AUTH_SECRET=set-a-unique-random-value-per-environment
#
# Also give each Railway environment its OWN database volume / DB_PATH so QA and
# prod never share data.

# ── FMP plan gates (optional — unset means no restriction) ───────────────────
# Starter plans limit governance-executive-compensation to specific tickers.
# Set a comma-separated allowlist here to skip FMP calls (and 402 log noise) for
# other symbols. Remove or leave blank after upgrading to fetch exec-comp for all.
# FMP_EXEC_COMP_SYMBOLS=AAPL,TSLA,AMZN,MSFT,NVDA,GOOGL,META,NFLX,JPM,V,BAC,PYPL,DIS,T,PFE,COST,INTC,KO,TGT,NKE,SPY,BA,BABA,XOM,WMT,GE,CSCO,VZ,JNJ,CVX,PLTR,SQ,SHOP,SBUX,SOFI,HOOD,RBLX,SNAP,AMD,UBER,FDX,ABBV,ETSY,MRNA,LMT,GM,F,LCID,CCL,DAL,UAL,AAL,TSM,SONY,ET,MRO,COIN,RIVN,RIOT,CPRX,VWO,SPYG,NOK,ROKU,VIAC,ATVI,BIDU,DOCU,ZM,PINS,TLRY,WBA,MGM,NIO,C,GS,WFC,ADBE,PEP,UNH,CARR,HCA,TWTR,BILI,SIRI,FUBO,RKT

# ── FMP rate limiting (important when QA + prod SHARE one FMP key) ────────────
# Each process rate-limits itself independently, so two environments on the same
# key can sum past your plan's limit. Cap each env so the TOTAL stays under it —
# e.g. prod FMP_MAX_RPM=250, QA FMP_MAX_RPM=40 (≈290 combined < 300 plan).
FMP_MAX_RPM=250
# The always-on background enrichment job is the biggest continuous consumer.
# Turn it OFF in QA (test on-demand only) so prod gets the quota; keep it on in prod.
ENABLE_BACKGROUND_ENRICH=true
BACKGROUND_ENRICH_RPM=150
# (Cleanest of all: give QA its own separate FMP key/plan if you can.)
