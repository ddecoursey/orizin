{
  "name": "orizin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:all": "node server/index.js & vite --host 0.0.0.0",
    "server": "node server/index.js",
    "reset-password": "node scripts/reset-password.mjs",
    "dev-server": "node --watch server/index.js",
    "start": "node server/index.js",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test \"server/tests/**/*.test.js\"",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:only": "playwright test",
    "test:e2e:deployed": "E2E_DEPLOYED=true playwright test e2e/deployed-journeys.spec.js",
    "test:e2e:preview": "playwright test e2e/core-flows.spec.js",
    "test:qa:provision": "node scripts/qa-e2e-users.mjs provision",
    "test:qa:cleanup": "node scripts/qa-e2e-users.mjs cleanup",
    "test:qa:wait": "node scripts/wait-for-deployment.mjs",
    "test:smoke": "node scripts/smoke-deployed.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "test:ci": "npm run lint && npm test && npm run build && npm run test:e2e:only",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-virtual": "^3.13.26",
    "@vitejs/plugin-react": "^6.0.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^9.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "framer-motion": "^12.40.0",
    "helmet": "^8.2.0",
    "node-fetch": "^3.3.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.12",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0"
  }
}
